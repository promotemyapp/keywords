{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "bunVersion": "1.x",
  "installCommand": "bun install",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "config/**/*.json"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/:path*", "destination": "/api/[...path]" }
  ]
}
