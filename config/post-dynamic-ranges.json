{
  "version": "1.0",
  "description": "Configurable dynamic numeric ranges for reusable post templates.",
  "active_profiles": ["blog"],
  "deferred_profiles": {
    "social_media": "Preserved for a later, independently designed social-media template milestone."
  },
  "profiles": {
    "blog": {
      "title": { "words": { "min": 3, "max": 12 } },
      "subtitles": {
        "count": { "min": 5, "max": 10 },
        "words": { "min": 2, "max": 12 }
      },
      "body": {
        "words": { "min": 2000, "max": 4000 },
        "sections": { "min": 5, "max": 10 }
      },
      "tags": { "count": { "min": 10, "max": 10 } }
    },
    "social_media": {
      "title": { "words": { "min": 2, "max": 12 } },
      "subtitles": {
        "count": { "min": 1, "max": 3 },
        "words": { "min": 1, "max": 8 }
      },
      "body": {
        "words": { "min": 30, "max": 150 },
        "sections": { "min": 1, "max": 3 }
      },
      "tags": { "count": { "min": 10, "max": 10 } }
    }
  }
}
